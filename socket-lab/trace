#!/usr/bin/env bash
#
# Run a program under strace, with the system call lines highlighted
# so they stand out from the program's own output, and a timestamp in
# front of every line (seconds since the lab started, see ./stamp):
#
#      5.004 │ recvfrom(4, "Hello server!", 1023, 0, NULL, NULL) = 13
#              ^^^^^^^^  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^    ^^
#              yellow    cyan, data in magenta                     green (red on error)
#
# Slow motion: after each socket system call the program waits LAB_DELAY
# seconds (default 1), so you can follow it. LAB_DELAY=0 turns this off.
#
#   usage: ./trace ./server
#          ./trace ./client
#          LAB_DELAY=0 ./trace ./client
#
# Only the system calls used in server.c / client.c are shown.
# (send() and recv() show up as sendto() and recvfrom(). dup() is there
# because perror() uses it, together with close(), to print an error.)

SYSCALLS=socket,setsockopt,bind,listen,accept,accept4,connect,getsockname,sendto,recvfrom,close,dup
SLOW=socket,setsockopt,bind,listen,accept,accept4,connect,getsockname,sendto,recvfrom

# strace delays these calls when they return (delay_exit, in microseconds).
DELAY_US=$(perl -e 'printf "%d", ($ARGV[0] // 1) * 1e6' "${LAB_DELAY:-1}")
SLOW_MOTION=()
if [ "$DELAY_US" -gt 0 ]; then
    SLOW_MOTION=(-e "inject=$SLOW:delay_exit=$DELAY_US")
fi

# Program output and strace output go through ONE pipe, so their order is
# preserved. The filter works on raw chunks, not whole lines, so an
# unfinished call like "accept(3, " shows up while the program is blocked.
#
# Colours: what a call has to do with the packets (the same as ./packets):
#   yellow   connection setup      connect(), accept()
#   magenta  data to the server    send/recv of "Hello server!"
#   cyan     data to the client    send/recv of "Hello client!"
#   red      closing               close() of a socket, recv() = 0, errors
#   grey     nothing on the wire   socket(), bind(), listen(), ...
# After every call that changes them, the open sockets are listed:
#   open fds: 3 = listening on :8080, 4 = connected to :43420
strace -e trace="$SYSCALLS" ${SLOW_MOTION[@]+"${SLOW_MOTION[@]}"} -e signal=none "$@" 2>&1 | perl -e '
    $| = 1;
    my %COLOUR = (setup => "33", to_server => "35", to_client => "36", closing => "31", local => "2");
    my ($OFF, $ERR) = ("\e[0m", "\e[1;31m");

    my %fd;      # open sockets: fd -> what it is ("listening on :8080", ...)
    my %side;    # fd -> "client" (it called connect) or "server" (it came from accept)

    # Which colour a call gets, decided when it starts: its name and first argument.
    sub category {
        my ($name, $fd) = @_;
        return "setup" if $name =~ /^(connect|accept4?)$/;
        if ($name eq "sendto")   { return ($side{$fd} // "") eq "server" ? "to_client" : "to_server" }
        if ($name eq "recvfrom") { return ($side{$fd} // "") eq "server" ? "to_server" : "to_client" }
        return "closing" if $name eq "close" && exists $fd{$fd};
        return "local";
    }

    # A whole strace line is done: update the list of open sockets.
    sub track {
        my ($line) = @_;
        my ($name, $fd, $result) = $line =~ /^(\w+)\((\d+)?.*\)\s+= (-?\d+)/ or return 0;
        return 0 if $result < 0;
        my ($port) = $line =~ /htons\((\d+)\)/;
        if    ($name eq "socket")                { $fd{$result} = "new socket" }
        elsif (!defined $fd)                     { return 0 }
        elsif ($name eq "bind")                  { $fd{$fd} = "bound to :$port" }
        elsif ($name eq "listen")                { my ($where) = ($fd{$fd} // "") =~ /(:\d+)/;
                                                   $fd{$fd} = "listening" . ($where ? " on $where" : "") }
        elsif ($name eq "connect")               { $fd{$fd} = "connected to :$port"; $side{$fd} = "client" }
        elsif ($name =~ /^accept/)               { $fd{$result} = "connected to :$port"; $side{$result} = "server" }
        elsif ($name eq "close" && exists $fd{$fd}) { delete $fd{$fd}; delete $side{$fd} }
        else                                     { return 0 }
        return 1;
    }

    sub fd_list {
        my $list = join ", ", map { "$_ = $fd{$_}" } sort { $a <=> $b } keys %fd;
        return "\e[2m  open fds: " . ($list || "none") . "$OFF\n";
    }

    my ($start, $strace, $line, $call, $colour) = (1, 0, "", "", "");
    while (sysread(STDIN, my $buf, 4096)) {
        for my $piece (split /(?<=\n)/, $buf) {
            # Resizing the terminal interrupts a blocked call, which strace
            # shows as "= ? ERESTARTSYS" before restarting it. The kernel
            # restarts it transparently, so erase that line to avoid confusion.
            if (!$start && $piece =~ /ERESTARTSYS/) {
                print "\r\e[2K$OFF";
                ($start, $line) = (1, "");
                next;
            }
            if ($start) {
                # Program lines start with SERVER:/CLIENT:/-----; anything else is strace.
                $strace = $piece !~ /^(SERVER|CLIENT|-----|\n)/;
                if ($strace) {
                    my ($name, $fd) = $piece =~ /^(\w+)\((\d+)?/;
                    $call = $name // "";
                    $colour = $piece =~ /^\+\+\+/ ? $COLOUR{local} : $COLOUR{category($call, $fd // -1)};
                    print "\e[${colour}m│ ";
                }
            }
            if (!$strace) {
                print $piece;
                $start = $piece =~ /\n$/;
                next;
            }
            my $nl = $piece =~ s/\n$//;
            $piece =~ s/ \(DELAYED\)$//;                          # added by the slow motion
            $line .= $piece;
            my $bold = $colour eq "2" ? "" : "\e[1m";             # grey lines stay plain
            $piece =~ s/^(\w+)\(/$bold$1\e[22m\e[${colour}m(/ if $start;
            $piece =~ s/("(?:[^"\\]|\\.)*")/$bold$1\e[22m\e[${colour}m/g;
            $piece =~ s/(\)\s+= )(-1|\?)(.*)$/$1$ERR$2$3/
                or ($call eq "recvfrom" and $piece =~ s/(\)\s+= )(0)$/$1$ERR$2/)
                or $piece =~ s/(\)\s+= )(\d+)/$1$bold$2/;
            print $piece;
            if ($nl) {
                print "$OFF\n";
                print fd_list() if track($line);
                $line = "";
            }
            $start = $nl;
        }
    }
' | "$(dirname "$0")/stamp"
