#!/usr/bin/env bash
#
# Like ./step, but also shows the socket system calls each line makes:
#
#   │  29      int listen_fd = socket(AF_INET, SOCK_STREAM, 0);
#         ↳ socket(AF_INET, SOCK_STREAM, 0) = 3
#   SERVER: socket() -> fd=3
#
# strace itself cannot run together with gdb, so gdb catches the
# system calls (see step.py).
#
#   usage: ./step_strace ./server
#          STEP_DELAY=1 ./step_strace ./client

# Keys you press are not echoed (the program does not read them anyway),
# so they do not end up in the middle of its output.
stty -echo 2>/dev/null
trap 'stty echo 2>/dev/null' EXIT

STEP_SYSCALLS=1 gdb -q -batch -nx -x "$(dirname "$0")/step.py" --args "$@" | "$(dirname "$0")/stamp"
