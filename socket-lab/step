#!/usr/bin/env bash
#
# Run a program under gdb and step through main() one line at a time,
# printing each line of C just before it runs:
#
#   │  27      int listen_fd = socket(AF_INET, SOCK_STREAM, 0);
#   SERVER: socket() -> fd=3
#
# When a line blocks (accept, recv, ...), it stays the last line on screen
# until the call returns. The stepping itself is done by step.py.
# ./step_strace does the same and also shows the system calls.
#
#   usage: ./step ./server
#          STEP_DELAY=1 ./step ./client     (seconds between lines, default 0.5)

exec gdb -q -batch -nx -x "$(dirname "$0")/step.py" --args "$@"
