#!/usr/bin/env bash
#
# Show the demo's TCP packets, one readable line per packet:
#
#      5.004  +2.003s  CLIENT:59456 → SERVER:8080   DATA      13   "Hello server!"
#
#    when (seconds since the lab started, the same clock as the timestamps
#    in the SERVER and CLIENT panes), the gap since the previous packet,
#    who sends to whom, what kind of packet it is, how many bytes of data
#    it carries, and the data itself.
#
# This runs plain tcpdump and rewrites its output. To see the raw tcpdump
# output instead, run:   tcpdump -i lo -nn 'tcp port 8080'
#
#   usage: ./packets

PORT=8080

# -tt  time of each packet, in seconds (since 1970)
# -x   hex dump of each packet (used here only to pull out the data)
tcpdump -i lo -nn -l --immediate-mode -tt -x "tcp port $PORT" 2>&1 | PORT="$PORT" perl -e '
    use Time::HiRes qw(time);
    $| = 1;
    my $port = $ENV{PORT};
    my $t0 = $ENV{LAB_T0} || time;    # set by start.sh, shared with ./stamp
    my $previous;

    sub paint { my ($colour, $text) = @_; "\e[${colour}m$text\e[0m" }

    sub who {
        my $p = shift;
        my $label = sprintf "%-12s", ($p == $port ? "SERVER" : "CLIENT") . ":$p";
        paint($p == $port ? "1;34" : "1;32", $label);
    }

    # Turn tcpdump flags ([S], [S.], [P.], [F.], [R], [.]) into names. The
    # colours are the same as for the system calls in the SERVER/CLIENT panes:
    # yellow = connection setup, magenta = data to the server,
    # cyan = data to the client, red = closing, grey = only an acknowledgement.
    sub kind {
        my ($flags, $len, $from) = @_;
        my @k;
        push @k, ($flags =~ /\./ ? "SYN-ACK" : "SYN") if $flags =~ /S/;
        push @k, "RST"  if $flags =~ /R/;
        push @k, "DATA" if $len > 0;
        push @k, "FIN"  if $flags =~ /F/;
        @k = ("ACK") unless @k;
        my $k = join "+", @k;
        my $colour = $k =~ /RST/ ? "1;31" : $k =~ /DATA/ ? ($from == $port ? "1;36" : "1;35")
                   : $k =~ /SYN/ ? "1;33" : $k =~ /FIN/ ? "1;31" : "2";
        paint($colour, sprintf "%-8s", $k);
    }

    my ($pending, $len, $need, $data_colour, @bytes);
    while (<STDIN>) {
        # Packet line, e.g.
        #  1792163391.135803 IP 127.0.0.1.59456 > 127.0.0.1.8080: Flags [P.], seq 1:14, ..., length 13: HTTP
        if (/^\s*([\d.]+) IP \S+?\.(\d+) > \S+?\.(\d+): Flags \[([^\]]*)\].*?length (\d+)/) {
            my ($t, $from, $to, $flags, $bytes) = ($1, $2, $3, $4, $5);
            my $gap = defined $previous ? $t - $previous : 0;
            $previous = $t;
            # Long gaps are where a program was blocked or sleeping.
            my $time = sprintf "%8.3f  %s", $t - $t0,
                paint($gap >= 0.5 ? "1" : "2", sprintf "%8s", sprintf "+%.3fs", $gap);
            my $line = sprintf "%s  %s \xe2\x86\x92 %s  %s  %-3d",
                $time, who($from), who($to), kind($flags, $bytes, $from), $bytes;
            if ($bytes > 0) {
                ($pending, $len, $need, @bytes) = ($line, $bytes, undef);   # wait for the data
                $data_colour = $from == $port ? "1;36" : "1;35";
            } else {
                print "$line\n";
                $pending = undef;
            }
            next;
        }
        # Hex dump line, e.g. "	0x0030:  e427 6bbe 4865 6c6c 6f20 7365 7276 6572"
        if (/^\s+0x[0-9a-f]+:\s+(.*)$/) {
            next unless defined $pending;
            push @bytes, map { hex } map { /(..)/g } split " ", $1;
            $need //= $bytes[2] * 256 + $bytes[3] if @bytes >= 4;    # IP total length
            if (defined $need && @bytes >= $need) {
                # The data is the last $len bytes of the packet.
                my $data = join "", map { chr } @bytes[$need - $len .. $need - 1];
                $data =~ s/\n/\\n/g;
                $data =~ s/([^\x20-\x7e])/sprintf "\\x%02x", ord $1/ge;
                $data = substr($data, 0, 40) . "..." if length $data > 40;
                print "$pending  ", paint($data_colour, "\"$data\""), "\n";
                $pending = undef;
            }
            next;
        }
        next if /verbose output suppressed/;
        if (/^listening on/) {
            print "Watching TCP port $port on the loopback interface. One line = one packet.\n\n";
            print paint("2", sprintf "%8s  %8s  %-15s%-14s%-10s%-5s%s", "TIME", "GAP", "FROM", "TO", "TYPE", "LEN", "DATA"), "\n";
            next;
        }
        print;    # anything else (e.g. an error from tcpdump) as it is
    }
'
